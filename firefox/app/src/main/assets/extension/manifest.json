{
  "manifest_version": 2,
  "name": "MoveTV pomocnik",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "movetv@webtv.rs" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
